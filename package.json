{
  "name": "lingualens",
  "version": "0.1.0",
  "description": "Fast, privacy-minded screen OCR and translation for Windows.",
  "main": "main.js",
  "author": "Codex",
  "license": "MIT",
  "dependencies": {
    "tesseract.js": "7.0.0"
  },
  "allowScripts": {
    "electron@43.2.0": true
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.lingualens.app",
    "productName": "LinguaLens",
    "directories": {
      "output": "../dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "portable": {
      "artifactName": "LinguaLens-0.1.0-portable.exe"
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
